# Embedding provider: "cohere", "dashscope", or "colqwen2"
EMBED_PROVIDER=colqwen2

# Cohere (https://cohere.com)
COHERE_API_KEY=your-cohere-api-key-here

# DashScope / Qwen (https://dashscope.console.aliyun.com)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Local ColQwen2 embedding model path (only used when EMBED_PROVIDER=colqwen2)
COLQWEN2_MODEL_PATH=./models/colqwen2-v1.0-merged
COLQWEN2_BATCH_SIZE=2
COLQWEN2_CANDIDATE_PATCHES=300
COLQWEN2_COLLECTION_NAME=pdf_rag_colqwen2

# LLM provider: openai_compatible / openrouter / dashscope
LLM_PROVIDER=openai_compatible

# OpenAI-compatible third-party API
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_MODEL=your-model-name

# OpenRouter (https://openrouter.ai) - OpenAI-compatible third-party API
OPENROUTER_API_KEY=your-openrouter-api-key-here

# DashScope vision model — used when LLM_PROVIDER=dashscope
# Options: qwen3.5-flash, qwen3.5-plus, qwen3-vl-plus, qwen-vl-max
DASHSCOPE_VL_MODEL=qwen3.5-flash

# Milvus 本地文件数据库，默认使用 Milvus Lite
MILVUS_URI=./data/milvus.db

# 如果你改用本地/自建 Milvus Server，也可以填连接地址，例如：
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_TOKEN=your-optional-token

COHERE_COLLECTION_NAME=pdf_rag_cohere
DASHSCOPE_COLLECTION_NAME=pdf_rag_dashscope
INDEX=IVF_FLAT
